{
  "name": "@isayme/httpbin",
  "version": "0.1.2",
  "description": "a express application boilerplate",
  "main": "app/app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node app/app-fastify.js",
    "start:express": "node app/app.js",
    "dev": "NODE_ENV=dev nodemon app/app-fastify.js",
    "test": "NODE_ENV=test nyc mocha './test/**/*.test.js'",
    "pretest": "npm run lint",
    "lint": "standard",
    "prettier": "prettier-standard 'app/**/*.js' 'test/**/*.js'",
    "coveralls": "nyc report --reporter=text-lcov | coveralls"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isayme/node-httpbin.git"
  },
  "keywords": [
    "express",
    "boilerplate"
  ],
  "author": "iSayme <isaymeorg@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/isayme/node-httpbin/issues"
  },
  "homepage": "https://github.com/isayme/node-httpbin#readme",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^9.0.0",
    "accepts": "^1.3.8",
    "app-module-path": "^2.2.0",
    "basic-auth": "^2.0.1",
    "body-parser": "^2.2.1",
    "config": "^4.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dd-trace": "^5.81.0",
    "express": "^5.2.1",
    "express-partial-response": "^1.0.4",
    "express-prettify": "^0.1.2",
    "fastify": "^5.6.2",
    "http2-express-bridge": "^1.0.7",
    "lodash": "^4.17.21",
    "mime-types": "^3.0.2",
    "multer": "^2.0.2",
    "pino": "^10.1.0",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "coveralls": "^3.1.1",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.11",
    "nyc": "^17.1.0",
    "power-assert": "^1.6.1",
    "prettier-standard": "^16.4.1",
    "standard": "^17.1.2",
    "supertest": "^7.1.4"
  },
  "standard": {
    "env": [
      "mocha"
    ]
  }
}
